# ---- Slack ----------------------------------------------------------------
# Signing Secret: Slack app -> Basic Information -> App Credentials
SLACK_SIGNING_SECRET=
# Bot token, starts xoxb-: Slack app -> OAuth & Permissions -> Bot User OAuth Token
SLACK_BOT_TOKEN=
# Only react to messages in this channel. Comma-separate to watch more than one.
SLACK_CHANNEL_IDS=C0C13NDGG7J

# ---- Get Licensed data access ---------------------------------------------
# "mcp" for testing against the existing GL-Assist MCP server,
# "mysql" for production against a read-only replica.
GL_ADAPTER=mcp

# --- when GL_ADAPTER=mcp ---
GL_MCP_URL=
GL_MCP_TOKEN=

# --- when GL_ADAPTER=mysql ---
GL_DB_HOST=
GL_DB_PORT=3306
GL_DB_USER=
GL_DB_PASSWORD=
GL_DB_NAME=

# ---- Claude (fuzzy matching fallback) -------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# ---- Behaviour -------------------------------------------------------------
GLADMIN_BASE_URL=https://www.get-licensed.co.uk/gladmin/v2/trainees
# How far back to search for a booking, in days
LOOKBACK_DAYS=14
# Max candidate bookings to list in one reply
MAX_CANDIDATES=5
# Set to "true" to log the reply instead of posting it (safe first run)
DRY_RUN=true
PORT=3000
